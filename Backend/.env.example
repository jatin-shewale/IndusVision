# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=indusvision

# ---------- JWT Auth ----------
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Google Gemini (AI insights / report summaries) ----------
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ---------- Worker Safety / Logs ----------
# Defaults to Worker-Safety/best.pt and Backend/logs/indusvision.log.
PPE_CONFIDENCE_THRESHOLD=0.5

# ---------- CORS ----------
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Email alerts (optional, for Module 7) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=safety_officer@example.com
